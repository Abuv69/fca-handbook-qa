# Copy this file to .env and fill it in. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://fca:fca@localhost:5432/fca

# --- Embeddings ---
# fastembed = real semantic embeddings, runs locally, downloads a small model once.
# hash      = offline stand-in for tests and the demo. Not semantic.
EMBEDDER=hash
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Answer model ---
# fake              = no model needed; returns the top source. For the demo and tests.
# openai_compatible = any endpoint that speaks the OpenAI chat-completions format
#                     (a hosted provider, or Ollama running on your own machine).
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=

# --- Retrieval ---
TOP_K=5
# Refuse without calling the model when the best vector similarity is below this.
# 0 disables it. Tune it on your evaluation set (see docs/PLAN.md, week 2).
MIN_SIMILARITY=0

# --- FCA Handbook API (fill in from the API portal after you sign in) ---
FCA_API_BASE_URL=
FCA_API_TOKEN=
# Path that returns the provisions of one sourcebook. {sourcebook} is replaced, e.g. CONC.
FCA_API_PROVISIONS_PATH=
FCA_API_AUTH_HEADER=Authorization
FCA_API_AUTH_PREFIX=Bearer 
FCA_API_DELAY_SECONDS=1.0
